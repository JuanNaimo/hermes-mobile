{
  "name": "hermes-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --test tests/sse.test.ts tests/transcript.test.ts",
    "mock": "node scripts/mock-server.mjs",
    "cap:android": "npm run build && cap add android; cap sync android && cap open android",
    "cap:ios": "npm run build && cap add ios; cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@capacitor/ios": "7.4.3",
    "@nous-research/ui": "0.18.2",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.4"
  }
}
